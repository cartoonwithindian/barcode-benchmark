# .dockerignore
# What is kept (intentional):
# - assets/ : vendored tesseract traineddata must be in the image (never fetched from CDN at runtime)
# - src/ : TypeScript source needed for the build stage
# - scripts/ : build/dev utilities referenced by tooling (e.g. package.json scripts, fixtures)
# - tsconfig.json, tsconfig.build.json : required by tsc
#
# What is excluded: everything not needed to build+run to keep layer size small and avoid leaking local state

# Build outputs and deps (will be produced/copied in stages)
dist
node_modules

# Test and documentation (not needed in production image)
tests
docs
clients
coverage
.nyc_output

# VCS and git state
.git
.gitignore

# Local scratch/probes and temp files
.scratch
ocrprobe.mjs
zxingprobe.mjs

# Environment files (secrets must never be baked into image)
.env
.env.*
!.env.example

# Editor/OS cruft
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock
