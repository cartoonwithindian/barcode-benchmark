# foodguard-vision-api environment example
# Copy this to `.env` for local development only. DO NOT commit real secrets.
# Values below use the real defaults from src/config/index.ts; secrets are explicitly marked.

# ─────────────────────────────────────────────────────────────────────────────
# HTTP Server
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Trust X-Forwarded-For (Render sets this). Default: false
TRUST_PROXY=false
LOG_LEVEL=info
LOG_PRETTY=false

# ─────────────────────────────────────────────────────────────────────────────
# Security (secrets)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated API keys. Empty disables auth. SECRET: set in production.
API_KEYS=

# CORS and HTTP access
ALLOW_HTTP=false
# Comma-separated extra hostnames allowed over http (internal storage)
HTTP_ALLOWED_HOSTS=
# Comma-separated hosts explicitly allowed to resolve to private IPs
PRIVATE_HOST_ALLOWLIST=
# Comma-separated allowed image hostnames
ALLOWED_IMAGE_HOSTS=
# Comma-separated allowed URL ports (non-standard)
ALLOWED_URL_PORTS=
# Comma-separated CORS origins
CORS_ORIGINS=

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# Body/request limits
BODY_LIMIT_BYTES=16384
# Hard wall-clock cap for a whole /analyze request; client gets 504 past it
REQUEST_TIMEOUT_MS=90000
# How many /v1/analyze requests run at once. 1 = lowest memory (512 MB hosts);
# raise on bigger instances for throughput at the cost of peak RSS.
MAX_CONCURRENT_ANALYSES=1

# ─────────────────────────────────────────────────────────────────────────────
# Ingestion Limits
# ─────────────────────────────────────────────────────────────────────────────
DOWNLOAD_TIMEOUT_MS=12000
DOWNLOAD_MAX_BYTES=8388608
MAX_REDIRECTS=3
MAX_IMAGE_DIMENSION=6000
MAX_IMAGE_PIXELS=40000000
# Longest edge of the working raster handed to the engines. 2200 = best decode
# resolution; 1600 fits a 512 MB instance (measured peak ~452 MB with OCR).
WORKING_MAX_DIMENSION=2200

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline (Barcode + OCR)
# ─────────────────────────────────────────────────────────────────────────────
BARCODE_MAX_VARIANTS=6
BARCODE_MAX_MS=9000
BARCODE_MIN_CONFIDENCE=0.5

# OCR
OCR_ENABLED=true
OCR_MAX_VARIANTS=3
OCR_TIMEOUT_MS=45000
# Path to tesseract traineddata inside the image. `assets/tessdata` = full
# model (11 MB); `assets/tessdata-fast` = fast model (1.9 MB, lower memory).
OCR_LANG_PATH=assets/tessdata
OCR_LANG=eng
OCR_WORKER_LIMIT=1
OCR_CACHE=false
# Smallest edge handed to Tesseract; smaller images are enlarged to it.
# 1400 recovers the most text but costs pixels linearly - on slow/0.1-CPU hosts
# set 0 (no enlarging) or the OCR stage will blow its budget. See README.
OCR_MIN_DIMENSION=1400

# ─────────────────────────────────────────────────────────────────────────────
# Cache
# ─────────────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=128
CACHE_TTL_SECONDS=900

# ─────────────────────────────────────────────────────────────────────────────
# Diagnostics
# ─────────────────────────────────────────────────────────────────────────────
EXPOSE_METRICS=true
# Include raw OCR text in logs (SECRET-sensitive in practice; default false)
LOG_OCR_TEXT=false
